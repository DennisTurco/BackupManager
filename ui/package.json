{
  "name": "backup-manager-ui",
  "version": "3.0.0",
  "description": "BackupManager desktop UI — Electron + React + TypeScript",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node scripts/prepare-dev.mjs --backend",
    "dev": "electron-vite dev",
    "dev:first-launch": "node scripts/first-launch.mjs",
    "dev:first-launch:demo": "node scripts/first-launch.mjs --demo",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win dir"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.56.2",
    "axios": "^1.7.7",
    "lucide-react": "^0.447.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.13.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "io.github.dj-raven.backupmanager",
    "productName": "BackupManager",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "../target/backupmanager-jar-with-dependencies.jar",
        "to": "backend.jar"
      },
      {
        "from": "../src/main/resources",
        "to": "src/main/resources"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "../jre",
        "to": "jre"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": [
        "dir"
      ],
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
