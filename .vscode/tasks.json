{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "UI: Ensure dependencies",
      "type": "shell",
      "command": "node",
      "args": ["scripts/prepare-dev.mjs", "--deps"],
      "options": {
        "cwd": "${workspaceFolder}/ui"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Maven: Build backend jar",
      "type": "shell",
      "command": ".\\mvnw.cmd",
      "args": ["clean", "package", "-DskipTests"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "UI: Install dependencies",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "options": {
        "cwd": "${workspaceFolder}/ui"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Run App",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/ui"
      },
      "dependsOn": ["UI: Ensure dependencies"],
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Inno Setup: Compile Script",
      "type": "process",
      "command": "ISCC.exe",
      "args": ["${file}"],
      "presentation": {
        "reveal": "always",
        "echo": false
      },
      "group": "build"
    }
  ]
}
