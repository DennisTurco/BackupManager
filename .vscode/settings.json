{
    "java.configuration.updateBuildConfiguration": "interactive",
    "java.format.settings.url": ".vscode/java-formatter.xml",
    // Keep VS Code (itself Electron) away from ui/node_modules/electron, otherwise it can
    // lock .asar files and break `npm install` with EBUSY
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/ui/out/**": true,
        "**/ui/release/**": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/ui/out": true,
        "**/ui/release": true
    }
}
